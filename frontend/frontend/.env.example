# TRINETRA frontend — environment template
# Copy to .env and adjust. NEVER hardcode temporary trycloudflare URLs in source.
#
# Architecture (three laptops, Cloudflare Tunnel) — Logic Receiver is source of truth:
#   MY LAPTOP (browser) --POST /receive-email-->  SUBHOM LAPTOP (backend, Cloudflare)
#   SUBHOM --> SAIKAT (Ollama) + MY LAPTOP (Logic receiver via Cloudflare)
#   MY LAPTOP (logic_receiver.py) stores final risk_score + verdict by case_id
#   MY LAPTOP (browser) --GET /analysis/{case_id}--> LOGIC RECEIVER (poll directly)
#
# Two base URLs are required:
#   VITE_BACKEND_BASE_URL  = Subhom's public backend (upload ONLY, e.g. https://<subhom>.trycloudflare.com)
#   VITE_LOGIC_BASE_URL    = Logic Receiver public URL (poll) — Cloudflare when multi-machine,
#                            or http://127.0.0.1:8000 when same-machine
# --------------------------------------------------------------------------

# --- Backend upload (Subhom) — Cloudflare public URL, no trailing slash ---
# Example (tunnel active): VITE_BACKEND_BASE_URL=https://episodes-dealing-authentication-protocols.trycloudflare.com
# Example (local dev):     VITE_BACKEND_BASE_URL=http://localhost:8000
VITE_BACKEND_BASE_URL=http://localhost:8000
# Legacy alias — prefer VITE_BACKEND_BASE_URL; kept for backward compat
VITE_API_BASE_URL=http://localhost:8000

# --- Logic receiver poll — browser talks directly to Logic Receiver ---
# Same-machine (logic on same laptop as browser): VITE_LOGIC_BASE_URL=http://127.0.0.1:8000
# Multi-machine (logic on different laptop, browser elsewhere): VITE_LOGIC_BASE_URL=https://<LOGIC-CLOUDFLARE-DOMAIN>.trycloudflare.com
# The browser must be able to reach this URL directly — do NOT use localhost when frontend is on another machine.
VITE_LOGIC_BASE_URL=http://127.0.0.1:8000

# --- API routes — must match backend + logic contracts ---
# POST multipart field "email" with ONE raw .eml  (to Subhom)
VITE_ANALYZE_PATH=/receive-email
# Poll for result on Logic Receiver: GET /analysis/{case_id} -> {status:"processing"} | {status:"completed", risk_score, verdict, ...} | {status:"failed"}
# Frontend MUST poll Logic Receiver, NOT Subhom's /analysis (per architecture #8)
VITE_ANALYSIS_PATH=/analysis

# --- Polling / timeout ---
# Total time frontend will poll logic receiver before giving up (ms). Backend returns 202 immediately.
VITE_API_TIMEOUT_MS=300000
# Interval between polls (ms). Ollama takes ~25s, so 1500ms is reasonable.
VITE_ANALYSIS_POLL_INTERVAL_MS=1500

# --- Upload guard (MB) — browser-side only ---
VITE_MAX_UPLOAD_MB=25
