# TRINETRA Logic Engine — environment template
# Copy to .env and adjust for local runs. Never commit real secrets.
# See config.yaml for threshold/weight defaults — any value can be overridden
# via TRINETRA_* env vars (e.g. TRINETRA_THRESHOLD_REPUTATION=75).

# --- Server ---
LOGIC_HOST=0.0.0.0
LOGIC_PORT=8000
LOGIC_LOG_LEVEL=INFO

# --- Backend callback (Subhom) — OPTIONAL, disabled by default ---
# Per new architecture, Logic Receiver is source of truth and frontend polls it directly.
# The callback is NOT needed for display. Only enable if Subhom needs a copy:
#   ENABLE_BACKEND_CALLBACK=true  -> POST ${BACKEND_PUBLIC_URL}/receive-logic-result
# Leave disabled (default) to keep Logic Receiver as sole owner of final result.
# Example: BACKEND_PUBLIC_URL=https://<SUBHOM-CLOUDFLARE-DOMAIN>  (SUBHOM_BACKEND_URL is alias)
ENABLE_BACKEND_CALLBACK=false
BACKEND_PUBLIC_URL=https://<SUBHOM-CLOUDFLARE-DOMAIN>

# --- Machine-to-machine public URL (MY laptop -> Cloudflare) ---
# This is the public URL that Cloudflare Tunnel exposes for THIS laptop's logic_receiver.
# It changes every time `cloudflared tunnel --url http://localhost:8000` restarts.
# Give this URL to Subhom (for POST /receive-analysis) and Saikat (for POST /receive-ollama).
# ALSO give this URL to frontend as VITE_LOGIC_BASE_URL when frontend runs on another machine.
# Do NOT hardcode a temporary trycloudflare URL in source code.
# Example: LOGIC_PUBLIC_BASE_URL=https://<MY-CLOUDFLARE-DOMAIN>.trycloudflare.com
LOGIC_PUBLIC_BASE_URL=https://<MY-CLOUDFLARE-DOMAIN>.trycloudflare.com

# --- CORS — frontend (browser) calls Logic Receiver directly ---
# Comma-separated allowed origins. Must include the frontend origin that polls GET /analysis/{case_id}.
# Defaults allow http://localhost:5173 and http://127.0.0.1:5173 (Vite dev). Add production origin if needed.
# Example: LOGIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.example.com
LOGIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional: override verdict thresholds ---
# TRINETRA_VERDICT_LOW_MAX=20
# TRINETRA_VERDICT_MEDIUM_MAX=40
# TRINETRA_VERDICT_HIGH_MAX=60
# TRINETRA_VERDICT_CRITICAL_MAX=80

# --- Optional: override rule weights ---
# TRINETRA_WEIGHT_SPF_FAIL=10
# TRINETRA_WEIGHT_DMARC_FAIL=15

# --- Optional: override scoring ---
# TRINETRA_SCORING_METHOD=capped
# TRINETRA_MAX_POSSIBLE_SCORE=

# --- Optional: logging ---
# TRINETRA_LOG_LEVEL=INFO
# TRINETRA_LOG_JSON=false
